# Public release metadata embedded into the static download page at build time.
# Mac downloads require an HTTPS URL and NEXT_PUBLIC_MAC_NOTARIZED=true.
NEXT_PUBLIC_DOWNLOAD_URL=
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_DOWNLOAD_SIZE=
NEXT_PUBLIC_WINDOWS_DOWNLOAD_SIZE=

# Enable only after signing, notarization and a clean-Mac installation test.
NEXT_PUBLIC_MAC_NOTARIZED=false
NEXT_PUBLIC_MAC_CHECKSUM_URL=
